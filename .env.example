# Django
DJANGO_SECRET_KEY=change-me-in-production-use-a-real-secret
DJANGO_SETTINGS_MODULE=wrapex.settings.development

# Database (matches docker-compose postgres service)
DB_NAME=wrapex
DB_USER=wrapex
DB_PASSWORD=wrapex
DB_HOST=postgres
DB_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# S3 / MinIO
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=wrapex-uploads
S3_REGION=us-east-1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3050

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
