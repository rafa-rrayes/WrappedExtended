# =============================================================================
# WrapEx production environment variables (placeholders only)
# =============================================================================
# Set these in your host's environment / secrets UI. Never commit real values.
# See DEPLOYMENT.md for the full walkthrough.

# -- Django -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=wrapex.settings.production
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# -- Database (PostgreSQL) ----------------------------------------------------
DB_NAME=wrapex
DB_USER=wrapex
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

# -- Redis / Celery -----------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -- S3-compatible storage (MinIO, Cloudflare R2, AWS S3, ...) ----------------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=wrapex-uploads
S3_REGION=us-east-1            # R2 uses "auto"
# Only read by docker-compose.dokploy.yml (the bundled MinIO container)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# -- Hosts, CORS, TLS ---------------------------------------------------------
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
FRONTEND_URL=https://app.example.com
# Set to False only if TLS is terminated at an edge proxy that does not forward
# the original scheme (see DEPLOYMENT.md).
SECURE_SSL_REDIRECT=True

# -- Stripe (optional in practice; see "Payments" in DEPLOYMENT.md) -----------
# Leave blank to run without payments, or use sk_test_ / pk_test_ keys to test.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# -- Optional -----------------------------------------------------------------
# SENTRY_DSN=
# DASHBOARD_QUERY_THROTTLE_RATE=60/minute

# -- Frontend (set in the frontend host, e.g. Vercel) -------------------------
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://app.example.com
