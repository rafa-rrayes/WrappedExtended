# Django
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_SETTINGS_MODULE=wrapex.settings.development

# Database
DB_NAME=wrapex
DB_USER=wrapex
DB_PASSWORD=wrapex
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=wrapex-uploads
S3_REGION=us-east-1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3050
